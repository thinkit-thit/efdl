# Configuration de production d'eFDL : /opt/efdl-modern/efdl.env (root:efdl, 640). NE JAMAIS VERSIONNER.
# __ORIGINS__ est remplacé par install.sh (adresses https des domaines servis).

# Mémoire Java (le VPS en a largement assez)
JAVA_OPTS=-Xms256m -Xmx1g

# Base MongoDB 4.4 locale (conteneur Docker « mongo »), base de production
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=fdl2025

# Application (tenant) utilisée quel que soit le domaine
EFDL_DEFAULT_SCHOOL_ID=sdi-fdl

# Hash BCrypt du mot de passe maître (compte « admin ») : générer avec backend/tools/hash-master-password.
# Mettre la valeur entre apostrophes (le hash contient des « $ »).
EFDL_ADMIN_MASTER_PASSWORD_HASH='$2a$10$remplacer.par.le.hash.bcrypt'

# Adresse publique
EFDL_ALLOWED_ORIGINS=__ORIGINS__

# Fichiers : photos de profil et autres fichiers (documents joints, archives)
EFDL_USER_IMAGE_FOLDER=/home/data/fdl/image/user
EFDL_FILES_ROOT=/home/data/fdl-modern

# E-mails (Gmail) : fichier à part, lisible par le service
EFDL_MAIL_CONFIG=/opt/efdl-modern/mail.properties

# Derrière Nginx (HTTPS) : écoute locale seulement, cookie de session sécurisé, en-têtes du proxy
SERVER_ADDRESS=127.0.0.1
SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_SERVLET_SESSION_COOKIE_SECURE=true
